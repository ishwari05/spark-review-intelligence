# ==============================================================================
# ReviewIQ Multi-Tenant SaaS Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (Safe for frontend exposure, used for client auth)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only service role key (NEVER expose to frontend/browser!)
# Used by Flask backend for administrative tasks, bypasses RLS when needed on server
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# (Optional) Direct Postgres connection string if using direct database pools
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Flask Application Settings
# ------------------------------------------------------------------------------
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# ------------------------------------------------------------------------------
# Storage Settings
# ------------------------------------------------------------------------------
# Supabase Storage bucket for uploaded datasets (CSV, Excel)
SUPABASE_DATASET_BUCKET=review-datasets
